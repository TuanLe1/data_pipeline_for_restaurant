me": "compile", "started_at": "2026-01-21T09:36:20.258271Z", "completed_at": "2026-01-21T09:36:20.263457Z"}, {"name": "execute", "started_at": "2026-01-21T09:36:20.274510Z", "completed_at": "2026-01-21T09:36:54.686564Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 34.43903565406799, "adapter_response": {"_message": "OK 71", "code": "OK", "rows_affected": 71, "data_scanned_in_bytes": 127631}, "message": "OK 71", "failures": null, "unique_id": "model.restaurant_analytics.revenue_daily", "compiled": true, "compiled_code": "\n\nWITH raw_data AS (\n    -- \u0110\u1ecdc t\u1eeb b\u1ea3ng staging \u0111\u00e3 \u0111\u01b0\u1ee3c tr\u1ecf \u0111\u00fang source\n    SELECT * FROM \"AwsDataCatalog\".\"restaurant_db\".\"stg_invoice_header\"\n)\n\nSELECT\n    report_date,\n    branch_name,\n    year,\n    month,\n    -- S\u1eecA \u1ede \u0110\u00c2Y: D\u00f9ng ref_id thay v\u00ec invoice_id\n    COUNT(DISTINCT ref_id) as total_orders, \n    \n    SUM(total_amount) as total_revenue,\n    \n    -- Tr\u00e1nh chia cho 0\n    CASE \n        WHEN COUNT(DISTINCT ref_id) > 0 THEN SUM(total_amount) / COUNT(DISTINCT ref_id)\n        ELSE 0 \n    END as aov\nFROM raw_data\nWHERE total_amount > 0\nGROUP BY 1, 2, 3, 4", "relation_name": "\"AwsDataCatalog\".\"restaurant_db\".\"revenue_daily\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-21T09:36:20.251748Z", "completed_at": "2026-01-21T09:36:20.262786Z"}, {"name": "execute", "started_at": "2026-01-21T09:36:20.263977Z", "completed_at": "2026-01-21T09:36:57.037335Z"}], "thread_id": "Thread-8 (worker)", "execution_time": 36.790878772735596, "adapter_response": {"_message": "OK 35004", "code": "OK", "rows_affected": 35004, "data_scanned_in_bytes": 4903687}, "message": "OK 35004", "failures": null, "unique_id": "model.restaurant_analytics.master_sales_analytics", "compiled": true, "compiled_code": "\n\n-- alias='view_master_sales_analytics' gi\u00fap dbt t\u1ea1o ra b\u1ea3ng c\u00f3 t\u00ean Y H\u1ec6T view c\u0169 c\u1ee7a b\u1ea1n.\n-- Looker Studio s\u1ebd t\u1ef1 \u0111\u1ed9ng nh\u1eadn di\u1ec7n b\u1ea3ng n\u00e0y m\u00e0 kh\u00f4ng c\u1ea7n config l\u1ea1i.\n\nWITH header AS (\n    SELECT * FROM \"AwsDataCatalog\".\"restaurant_db\".\"stg_invoice_header\"\n),\n\ndetail AS (\n    SELECT * FROM \"AwsDataCatalog\".\"restaurant_db\".\"stg_invoice_detail\"\n)\n\nSELECT \n    -- 1. Dimensions\n    h.branch_name,\n    h.ref_id AS order_id,\n    h.ref_no AS invoice_code,\n    h.customer_id,\n    d.item_name,\n    d.item_id,\n    \n    -- 2. Time\n    h.ref_date,\n    -- \u00c9p ki\u1ec3u Date an to\u00e0n h\u01a1n cho Athena Iceberg\n    CAST(h.ref_date AS DATE) AS report_date,\n    date_format(h.ref_date, '%H') AS report_hour,\n    h.day, \n    h.month, \n    h.year,\n\n    -- 3. Metrics\n    d.quantity,\n    \n    -- [A] Doanh thu thu\u1ea7n (Pre-tax Revenue)\n    (d.amount \n     - COALESCE(d.allocation_amount, 0) \n     - COALESCE(d.allocation_delivery_promotion_amount, 0)\n    ) AS net_revenue_pre_tax,\n\n    -- [B] Thu\u1ebf VAT\n    COALESCE(d.tax_amount, 0) AS tax_amount,\n\n    -- [C] Doanh thu t\u1ed5ng (Gross Revenue)\n    (d.amount \n     - COALESCE(d.allocation_amount, 0) \n     - COALESCE(d.allocation_delivery_promotion_amount, 0)\n     + COALESCE(d.tax_amount, 0)\n    ) AS net_revenue_inclusive\n\nFROM detail d\nJOIN header h \n    ON d.ref_id = h.ref_id\nWHERE h.payment_status <> 4", "relation_name": "\"AwsDataCatalog\".\"restaurant_db\".\"view_master_sales_analytics\"", "batch_results": null}], "elapsed_time": 59.56330060958862, "args": {"require_batched_execution_for_custom_microbatch_strategy": false, "defer": false, "macro_debugging": false, "printer_width": 80, "introspect": true, "cache_selected_only": false, "log_level_file": "debug", "static_parser": true, "select": [], "require_resource_names_without_spaces": true, "log_file_max_bytes": 10485760, "require_yaml_configuration_for_mf_time_spines": false, "require_all_wa